# Source explicitly from bash; adjust for host CPU and memory capacity.
export GOMAXPROCS=2
export GOGC=200
export MEM_LIMIT=66206023680
export MILVUS_CPUS=0-4
export MINIO_CPUS=5-6
export ETCD_CPUS=7
export MALLOC_CONF='background_thread:true,narenas:1,dirty_decay_ms:600000,muzzy_decay_ms:600000,thp:always'
