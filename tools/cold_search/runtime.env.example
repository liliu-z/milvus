# Source explicitly from bash; adjust for host CPU and memory capacity.
export GOMAXPROCS=${GOMAXPROCS:-2}
export GOGC=${GOGC:-200}
export MEM_LIMIT=${MEM_LIMIT:-66206023680}
export MILVUS_CPUS=${MILVUS_CPUS:-0-4}
export MINIO_CPUS=${MINIO_CPUS:-5-6}
export ETCD_CPUS=${ETCD_CPUS:-7}
export MALLOC_CONF=${MALLOC_CONF:-background_thread:true,narenas:1,dirty_decay_ms:600000,muzzy_decay_ms:600000,thp:always}
