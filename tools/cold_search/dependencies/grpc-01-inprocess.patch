+// Copyright 2026 gRPC authors.
+// Licensed under the Apache License, Version 2.0.
+
+package transport
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"google.golang.org/grpc/internal/proxyattributes"
+	"google.golang.org/grpc/resolver"
+)
+
+func TestInProcessRegistrationGeneration(t *testing.T) {
+	address := "127.0.0.1:30002"
+	unregister, ok := RegisterInProcessDialer(address, nil)
+	if !ok {
+		t.Fatal("initial registration failed")
+	}
+	if _, ok := RegisterInProcessDialer(address, nil); ok {
+		t.Fatal("duplicate replaced live registration")
+	}
+	unregister()
+	newUnregister, ok := RegisterInProcessDialer(address, nil)
+	if !ok {
+		t.Fatal("new generation could not register")
+	}
+	defer newUnregister()
+	unregister()
+	if _, ok := inProcessDialers.Load(address); !ok {
+		t.Fatal("old generation removed new listener")
+	}
+}
+
+func TestInProcessProxyPrecedence(t *testing.T) {
+	seen := make(chan string, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		seen <- r.Method
+		w.WriteHeader(http.StatusForbidden)
+	}))
+	defer server.Close()
+	address := strings.TrimPrefix(server.URL, "http://")
+	called := false
+	unregister, ok := RegisterInProcessDialer(address, func(context.Context) (net.Conn, error) {
+		called = true
+		return nil, errors.New("local path must not bypass configured proxy")
+	})
+	if !ok {
+		t.Fatal("registration failed")
+	}
+	defer unregister()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	addr := proxyattributes.Set(resolver.Address{Addr: address}, proxyattributes.Options{ConnectAddr: "backend.invalid:1234"})
+	if conn, err := dial(ctx, nil, addr, "test"); err == nil {
+		conn.Close()
+		t.Fatal("proxy rejection lost")
+	}
+	if called {
+		t.Fatal("configured proxy bypassed")
+	}
+	select {
+	case method := <-seen:
+		if method != http.MethodConnect {
+			t.Fatal(method)
+		}
+	case <-ctx.Done():
+		t.Fatal("proxy not contacted")
+	}
+}
