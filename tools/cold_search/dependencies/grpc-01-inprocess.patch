@@ -0,0 +1,58 @@
+// Copyright 2026 gRPC authors.
+// Licensed under the Apache License, Version 2.0.
+
+package grpc
+
+import (
+	"fmt"
+	"sync"
+
+	"google.golang.org/grpc/internal/transport"
+	"google.golang.org/grpc/test/bufconn"
+)
+
+// ServeInProcess serves the existing HTTP/2 gRPC protocol over bounded memory
+// connections for one exact advertised address. It does not replace a TCP
+// listener. Credentials, codecs, interceptors, stats and message limits remain
+// on the ordinary client/server paths. Other addresses keep ordinary dialing.
+//
+// This is an experimental opt-in API for standalone deployment measurements.
+// Stop and GracefulStop include these connections. The returned cleanup closes
+// this listener and unregisters its address; active connections are owned by s.
+func (s *Server) ServeInProcess(address string, bufferSize int) (func(), error) {
+	if address == "" || bufferSize <= 0 {
+		return nil, fmt.Errorf("grpc: invalid in-process listener configuration")
+	}
+	s.mu.Lock()
+	stopped := s.lis == nil
+	s.mu.Unlock()
+	if stopped {
+		return nil, ErrServerStopped
+	}
+	lis := bufconn.Listen(bufferSize)
+	unregister, ok := transport.RegisterInProcessDialer(address, lis.DialContext)
+	if !ok {
+		lis.Close()
+		return nil, fmt.Errorf("grpc: in-process address already registered: %s", address)
+	}
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		defer unregister()
+		defer lis.Close()
+		// A concurrent Stop may win before this goroutine starts. Serve then
+		// closes lis and returns ErrServerStopped without accepting a connection.
+		_ = s.Serve(lis)
+	}()
+	var once sync.Once
+	return func() {
+		once.Do(func() {
+			unregister()
+			lis.Close()
+			<-done
+		})
+	}, nil
+}
+
+// InProcessDialCount returns successful in-process connections in this process.
+func InProcessDialCount() uint64 { return transport.InProcessDialCount.Load() }
