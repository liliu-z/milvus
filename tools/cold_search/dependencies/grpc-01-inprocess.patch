+// Copyright 2026 gRPC authors.
+// Licensed under the Apache License, Version 2.0.
+
+package transport
+
+import (
+	"context"
+	"net"
+	"sync"
+	"sync/atomic"
+)
+
+type inProcessDialer struct {
+	dial func(context.Context) (net.Conn, error)
+}
+
+var inProcessDialers sync.Map
+var InProcessDialCount atomic.Uint64
+
+// RegisterInProcessDialer installs an exact-address transport. Custom dialers
+// and proxy routing take precedence. Unregister only removes this generation.
+func RegisterInProcessDialer(address string, dial func(context.Context) (net.Conn, error)) (func(), bool) {
+	entry := &inProcessDialer{dial: dial}
+	if _, loaded := inProcessDialers.LoadOrStore(address, entry); loaded {
+		return nil, false
+	}
+	return func() { inProcessDialers.CompareAndDelete(address, entry) }, true
+}
