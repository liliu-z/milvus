+func TestFenceOwnedWriterDrainsWithoutRemoteWait(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	cfg, err := config.NewConfiguration()
+	require.NoError(t, err)
+	w, err := NewLocalFileWriter(ctx, dir, 81, 0, cfg)
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, w.Close(ctx)) })
+	for i := int64(0); i < 3; i++ {
+		_, err := w.WriteDataAsync(ctx, i, []byte("persist before fence returns"), nil)
+		require.NoError(t, err)
+	}
+	started := time.Now()
+	last, err := w.Fence(ctx)
+	elapsed := time.Since(started)
+	require.NoError(t, err)
+	require.Equal(t, int64(2), last)
+	require.Less(t, elapsed, time.Second, "own flock must not wait for a remote writer")
+	_, err = w.WriteDataAsync(ctx, 3, []byte("must reject"), nil)
+	require.True(t, werr.ErrSegmentFenced.Is(err))
+	require.NoError(t, w.Close(ctx))
+	recovered, err := NewLocalFileWriterWithMode(ctx, dir, 81, 0, cfg, true)
+	require.NoError(t, err)
+	defer recovered.Close(ctx)
+	require.Equal(t, int64(2), recovered.GetLastEntryId(ctx))
+	require.True(t, recovered.fenced.Load())
+	t.Logf("owned Fence completed in %s; three entries recovered", elapsed)
+}
+
+func TestFenceRecoveryWriterRetainsRemoteWait(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	cfg, err := config.NewConfiguration()
+	require.NoError(t, err)
+	owner, err := NewLocalFileWriter(ctx, dir, 82, 0, cfg)
+	require.NoError(t, err)
+	defer owner.Close(ctx)
+	recovery, err := NewLocalFileWriterWithMode(ctx, dir, 82, 0, cfg, true)
+	require.NoError(t, err)
+	defer recovery.Close(ctx)
+	started := time.Now()
+	_, err = recovery.Fence(ctx)
+	require.NoError(t, err)
+	require.GreaterOrEqual(t, time.Since(started), 5*time.Second,
+		"recovery handle does not own the writer flock")
+	require.Eventually(t, func() bool { return owner.fenced.Load() }, time.Second, time.Millisecond)
+	_, err = owner.WriteDataAsync(ctx, 0, []byte("must reject"), nil)
+	require.True(t, werr.ErrSegmentFenced.Is(err))
+}
