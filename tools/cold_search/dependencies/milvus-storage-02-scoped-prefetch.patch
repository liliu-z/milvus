+// Copyright 2026 Zilliz
+// Licensed under the Apache License, Version 2.0.
+#pragma once
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <arrow/buffer.h>
+#include <arrow/filesystem/filesystem.h>
+
+namespace milvus_storage::parquet {
+
+// A consume-once handoff, owned by an explicit operation scope. This is NOT a
+// persistent file cache. Keep the scope alive until the load completes, and
+// Cancel it on every exit. Filesystem identity retains the credentials/bucket
+// boundary; callers must use immutable object keys.
+class ScopedFilePrefetch {
+ public:
+  struct State;
+  static std::shared_ptr<ScopedFilePrefetch> Reserve(
+      std::shared_ptr<arrow::fs::FileSystem> fs, std::string path, int64_t size);
+  ~ScopedFilePrefetch();
+  void Run() noexcept;
+  void Cancel() noexcept;
+  uint64_t Hits() const;
+  static std::shared_ptr<arrow::Buffer> Take(
+      const std::shared_ptr<arrow::fs::FileSystem>& fs, const std::string& path, int64_t size);
+  static int64_t ReservedBytes();
+
+ private:
+  explicit ScopedFilePrefetch(std::shared_ptr<State> state) : state_(std::move(state)) {}
+  std::shared_ptr<State> state_;
+};
+}  // namespace milvus_storage::parquet
